# ── Django ──────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ── Claude connector sign-in ─────────────────────────
# The API's public address, and the website page where the customer approves a connection.
OAUTH_ISSUER=https://your-domain.com
OAUTH_AUTHORIZE_URL=https://your-domain.com/oauth/authorize

# ── Customer sign-up emails (Gmail app password, never in chat or git) ──
SITE_URL=https://your-domain.com
ADMIN_EMAIL=you@gmail.com
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL defaults to EMAIL_HOST_USER

# ── Database ─────────────────────────────────────────
DB_NAME=smart_orders
DB_USER=postgres
DB_PASS=strong-password-here
DB_HOST=db
DB_PORT=5432

# ── External services ────────────────────────────────
# AI model: openai (default) | anthropic | deepseek; LLM_MODEL overrides the provider's default model
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Operating hours, Israel time (HH:MM): suppliers update prices 03:00-10:00, customers order 10:00-22:00.
# HOURS_LIMIT_ENABLED=0 turns the limit off (emergency). Admins are never limited.
HOURS_LIMIT_ENABLED=1
SUPPLIER_OPEN=03:00
SUPPLIER_CLOSE=10:00
CUSTOMER_OPEN=10:00
CUSTOMER_CLOSE=22:00
# Voice messages (WhatsApp): speech-to-text. openai (default); STT_MODEL overrides the default model
# (gpt-4o-transcribe); STT_API_KEY defaults to OPENAI_API_KEY; STT_MAX_SECONDS is the longest recording (default 180)
STT_PROVIDER=openai
STT_MODEL=
STT_API_KEY=
STT_MAX_SECONDS=180
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_SKIP_SIGNATURE_VALIDATION=0

# ── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com
